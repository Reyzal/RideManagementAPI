```gitignore
# =========================
# Python cache / compiled files
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so

# =========================
# Virtual environments
# =========================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# =========================
# uv / Python tooling
# =========================
.python-version
__pypackages__/

# Keep uv.lock committed for reproducible installs
# Do not ignore uv.lock

# =========================
# Django
# =========================
*.sqlite3
*.sqlite3-journal
db.sqlite3
local_settings.py
media/
staticfiles/

# IMPORTANT:
# Do NOT ignore Django migrations.
# migrations/*.py files should be committed.
# Only cache files inside migrations are ignored by __pycache__/ and *.pyc above.

# =========================
# Environment / secrets
# =========================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.json
credentials.json

# =========================
# PyCharm / JetBrains
# =========================
.idea/
*.iml
*.iws
*.ipr

# =========================
# VS Code
# =========================
.vscode/

# =========================
# Testing / coverage
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
junit.xml
test-results/
reports/

# =========================
# Type checking / linting cache
# =========================
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# =========================
# Build / packaging
# =========================
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# =========================
# Logs / temp files
# =========================
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Database dumps / backups
# =========================
*.dump
*.sql
*.backup

# =========================
# Docker local overrides
# =========================
docker-compose.override.yml
```
